From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 12:00:00 +0000
Subject: [PATCH] net: phy: realtek: tell RTL826x models apart in probe

RTL8251L, RTL8261BE and RTL8261N report the same PHY ID, as do RTL8254B
and RTL8264B. Each model has a driver entry of its own whose
match_phy_device() reads the VEND1 package model and version registers
to tell them apart.

phylib does not guarantee that the PHY is out of reset when it runs the
match. phy_probe() asserts the reset GPIO when it fails and phy_remove()
always does, while phy_probe() releases it only right before calling the
driver's probe(). A match after a deferred or failed probe, a driver
unbind or a module reload therefore reads the registers of a PHY held in
reset. As the RTL8261BE/N entries require a package model of 0x8261,
none of the entries matches and phy_attach_direct() binds the generic
Clause 45 driver instead.

Match on the PHY ID only, with one entry per PHY ID, and read the
package model and version registers from rtl826x_probe(), which runs
with the reset released. The former entries' behaviour is kept:
RTL8251L and RTL8254B still drop 10GBASE-T from the supported link
modes, now from rtl826x_get_features(), and the USXGMII SerDes reset
work-around still only runs on RTL8261BE/N. An unknown package model on
the RTL8261N PHY ID is still refused, now with a warning, while RTL8264B
still takes any package model other than RTL8254B's.

The driver name now covers the whole family, so log the detected model.

---
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -11,6 +11,8 @@
 struct rtl826x_priv {
 	struct rtlgen_phy_patch_db *patch;
 	bool enable_pma_low_power:1;
+	bool limit_5g:1;
+	bool sds_reset:1;
 	struct phy_device *phydev;
 	struct delayed_work sds_work;
 	bool sds_work_disabled;
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -2922,123 +2922,24 @@ static int rtl8251b_c45_match_phy_device
 	return rtlgen_is_c45_match(phydev, RTL_8251B, true);
 }
 
-static int rtl8251l_match_phy_device(struct phy_device *phydev,
-				     const struct phy_driver *phydrv)
-{
-	int data;
-
-	if (!rtlgen_is_c45_match(phydev, RTL_8261N, true))
-		return 0;
-
-	if (!phydev->mdio.bus->read_c45)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
-	if (data < 0)
-		return 0;
-
-	if (data != RTL826X_VEND1_PKG_MODEL_8251)
-		return 0;
-
-	return 1;
-}
-
-static int rtl8254b_match_phy_device(struct phy_device *phydev,
-				     const struct phy_driver *phydrv)
-{
-	int data;
-
-	if (!rtlgen_is_c45_match(phydev, RTL_8264B, true))
-		return 0;
-
-	if (!phydev->mdio.bus->read_c45)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
-	if (data < 0)
-		return 0;
-
-	if (data != RTL826X_VEND1_PKG_MODEL_8254)
-		return 0;
-
-	return 1;
-}
-
-static int rtl8261be_match_phy_device(struct phy_device *phydev,
-				      const struct phy_driver *phydrv)
-{
-	int data;
-
-	if (!rtlgen_is_c45_match(phydev, RTL_8261N, true))
-		return 0;
-
-	if (!phydev->mdio.bus->read_c45)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
-	if (data < 0)
-		return 0;
-
-	if (data != RTL826X_VEND1_PKG_MODEL_8261)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_VERSION_ID);
-	if (data < 0)
-		return 0;
-
-	if ((data & RTL826X_VEND1_VERSION_ID_MODEL) != RTL826X_VEND1_VERSION_ID_MODEL_BE)
-		return 0;
-
-	return 1;
-}
-
-static int rtl8261n_match_phy_device(struct phy_device *phydev,
-				     const struct phy_driver *phydrv)
+/* RTL8251L, RTL8261BE and RTL8261N share a PHY ID, and so do RTL8254B and
+ * RTL8264B. Match on the PHY ID only and tell the models apart in
+ * rtl826x_probe(): phylib can run the match while the PHY is held in reset,
+ * e.g. when retrying after a deferred probe, whereas phy_probe() always
+ * releases the reset before calling into the driver.
+ */
+static int rtl8261n_c45_match_phy_device(struct phy_device *phydev,
+					 const struct phy_driver *phydrv)
 {
-	int data;
-
-	if (!rtlgen_is_c45_match(phydev, RTL_8261N, true))
-		return 0;
-
-	if (!phydev->mdio.bus->read_c45)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
-	if (data < 0)
-		return 0;
-
-	if (data != RTL826X_VEND1_PKG_MODEL_8261)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_VERSION_ID);
-	if (data < 0)
-		return 0;
-
-	if ((data & RTL826X_VEND1_VERSION_ID_MODEL) == RTL826X_VEND1_VERSION_ID_MODEL_BE)
-		return 0;
-
-	return 1;
+	return rtlgen_is_c45_match(phydev, RTL_8261N, true) &&
+	       phydev->mdio.bus->read_c45;
 }
 
-static int rtl8264b_match_phy_device(struct phy_device *phydev,
-				     const struct phy_driver *phydrv)
+static int rtl8264b_c45_match_phy_device(struct phy_device *phydev,
+					 const struct phy_driver *phydrv)
 {
-	int data;
-
-	if (!rtlgen_is_c45_match(phydev, RTL_8264B, true))
-		return 0;
-
-	if (!phydev->mdio.bus->read_c45)
-		return 0;
-
-	data = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
-	if (data < 0)
-		return 0;
-
-	if (data == RTL826X_VEND1_PKG_MODEL_8254)
-		return 0;
-
-	return 1;
+	return rtlgen_is_c45_match(phydev, RTL_8264B, true) &&
+	       phydev->mdio.bus->read_c45;
 }
 
 static int rtlgen_resume(struct phy_device *phydev)
@@ -3315,6 +3216,9 @@ static void rtl826x_link_change_notify(s
 {
 	struct rtl826x_priv *priv = phydev->priv;
 
+	if (!priv->sds_reset)
+		return;
+
 	if (phydev->state != PHY_RUNNING) {
 		if (!priv->sds_work_disabled) {
 			disable_delayed_work(&priv->sds_work);
@@ -3340,6 +3244,59 @@ static void rtl826x_cancel_sds_work(void
 	cancel_delayed_work_sync(&priv->sds_work);
 }
 
+static int rtl826x_detect_model(struct phy_device *phydev)
+{
+	struct rtl826x_priv *priv = phydev->priv;
+	const char *model;
+	int pkg, ver;
+
+	if (rtlgen_is_c45_match(phydev, RTL_8264B, true)) {
+		pkg = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
+		if (pkg < 0)
+			return pkg;
+
+		if (pkg == RTL826X_VEND1_PKG_MODEL_8254) {
+			model = "RTL8254B";
+			priv->limit_5g = true;
+		} else {
+			model = "RTL8264B";
+		}
+	} else if (rtlgen_is_c45_match(phydev, RTL_8261N, true)) {
+		pkg = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
+		if (pkg < 0)
+			return pkg;
+
+		switch (pkg) {
+		case RTL826X_VEND1_PKG_MODEL_8251:
+			model = "RTL8251L";
+			priv->limit_5g = true;
+			break;
+		case RTL826X_VEND1_PKG_MODEL_8261:
+			ver = phy_read_mmd(phydev, MDIO_MMD_VEND1,
+					   RTL826X_VEND1_VERSION_ID);
+			if (ver < 0)
+				return ver;
+
+			if ((ver & RTL826X_VEND1_VERSION_ID_MODEL) ==
+			    RTL826X_VEND1_VERSION_ID_MODEL_BE)
+				model = "RTL8261BE";
+			else
+				model = "RTL8261N";
+			priv->sds_reset = true;
+			break;
+		default:
+			phydev_warn(phydev, "unknown package model 0x%04x\n", pkg);
+			return -ENODEV;
+		}
+	} else {
+		return 0;
+	}
+
+	phydev_info(phydev, "%s detected\n", model);
+
+	return 0;
+}
+
 static int rtl826x_probe(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
@@ -3354,6 +3311,10 @@ static int rtl826x_probe(struct phy_devi
 	priv->phydev = phydev;
 	phydev->priv = priv;
 
+	ret = rtl826x_detect_model(phydev);
+	if (ret)
+		return ret;
+
 	INIT_DELAYED_WORK(&priv->sds_work, rtl826x_sds_reset_work);
 	ret = devm_add_action_or_reset(dev, rtl826x_cancel_sds_work, priv);
 	if (ret)
@@ -3480,23 +3441,7 @@ static int rtl826x_suspend(struct phy_de
 
 static int rtl826x_get_features(struct phy_device *phydev)
 {
-	int ret;
-
-	ret = genphy_c45_pma_read_abilities(phydev);
-	if (ret)
-		return ret;
-
-	/* not support 10M modes */
-	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Half_BIT,
-			   phydev->supported);
-	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT,
-			   phydev->supported);
-
-	return 0;
-}
-
-static int rtl825xb_get_features(struct phy_device *phydev)
-{
+	struct rtl826x_priv *priv = phydev->priv;
 	int ret;
 
 	ret = genphy_c45_pma_read_abilities(phydev);
@@ -3510,8 +3455,9 @@ static int rtl825xb_get_features(struct
 			   phydev->supported);
 
 	/* faulty rtl826x silicon having issues with 10G, sold as only 5G phy */
-	linkmode_clear_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT,
-			   phydev->supported);
+	if (priv->limit_5g)
+		linkmode_clear_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT,
+				   phydev->supported);
 
 	return 0;
 }
@@ -4172,59 +4118,7 @@ static struct phy_driver realtek_drvs[]
 		.led_hw_control_set	= rtl8261x_led_hw_control_set,
 		.led_polarity_set	= rtl8261x_led_polarity_set,
 	}, {
-		.name           = "RTL8251L 5Gbps PHY",
-		.config_init    = rtl826x_config_init,
-		.probe          = rtl826x_probe,
-		.get_features   = rtl825xb_get_features,
-		.suspend        = rtl826x_suspend,
-		.resume         = rtlgen_c45_resume,
-		.config_aneg    = rtl826x_config_aneg,
-		.aneg_done      = genphy_c45_aneg_done,
-		.read_status    = rtl826x_read_status,
-		.config_intr    = rtl826x_config_intr,
-		.handle_interrupt = rtl826x_handle_interrupt,
-		.match_phy_device = rtl8251l_match_phy_device,
-		.set_wol        = rtl826x_set_wol,
-		.get_wol        = rtl826x_get_wol,
-		.get_tunable    = rtl826x_get_tunable,
-		.set_tunable    = rtl826x_set_tunable,
-	}, {
-		.name           = "RTL8254B 5Gbps PHY",
-		.config_init    = rtl826x_config_init,
-		.probe          = rtl826x_probe,
-		.get_features   = rtl825xb_get_features,
-		.suspend        = rtl826x_suspend,
-		.resume         = rtlgen_c45_resume,
-		.config_aneg    = rtl826x_config_aneg,
-		.aneg_done      = genphy_c45_aneg_done,
-		.read_status    = rtl826x_read_status,
-		.config_intr    = rtl826x_config_intr,
-		.handle_interrupt = rtl826x_handle_interrupt,
-		.match_phy_device = rtl8254b_match_phy_device,
-		.set_wol        = rtl826x_set_wol,
-		.get_wol        = rtl826x_get_wol,
-		.get_tunable    = rtl826x_get_tunable,
-		.set_tunable    = rtl826x_set_tunable,
-	}, {
-		.name           = "RTL8261BE 10Gbps PHY",
-		.config_init    = rtl826x_config_init,
-		.link_change_notify = rtl826x_link_change_notify,
-		.probe          = rtl826x_probe,
-		.get_features   = rtl826x_get_features,
-		.suspend        = rtl826x_suspend,
-		.resume         = rtlgen_c45_resume,
-		.config_aneg    = rtl826x_config_aneg,
-		.aneg_done      = genphy_c45_aneg_done,
-		.read_status    = rtl826x_read_status,
-		.config_intr    = rtl826x_config_intr,
-		.handle_interrupt = rtl826x_handle_interrupt,
-		.match_phy_device = rtl8261be_match_phy_device,
-		.set_wol        = rtl826x_set_wol,
-		.get_wol        = rtl826x_get_wol,
-		.get_tunable    = rtl826x_get_tunable,
-		.set_tunable    = rtl826x_set_tunable,
-	}, {
-		.name           = "RTL8261N 10Gbps PHY",
+		.name           = "RTL8261N family PHY",
 		.config_init    = rtl826x_config_init,
 		.link_change_notify = rtl826x_link_change_notify,
 		.probe          = rtl826x_probe,
@@ -4236,7 +4130,7 @@ static struct phy_driver realtek_drvs[]
 		.read_status    = rtl826x_read_status,
 		.config_intr    = rtl826x_config_intr,
 		.handle_interrupt = rtl826x_handle_interrupt,
-		.match_phy_device = rtl8261n_match_phy_device,
+		.match_phy_device = rtl8261n_c45_match_phy_device,
 		.set_wol        = rtl826x_set_wol,
 		.get_wol        = rtl826x_get_wol,
 		.get_tunable    = rtl826x_get_tunable,
@@ -4259,7 +4153,7 @@ static struct phy_driver realtek_drvs[]
 		.get_tunable    = rtl826x_get_tunable,
 		.set_tunable    = rtl826x_set_tunable,
 	}, {
-		.name           = "RTL8264B 10Gbps PHY",
+		.name           = "RTL8264B family PHY",
 		.config_init    = rtl826x_config_init,
 		.probe          = rtl826x_probe,
 		.get_features   = rtl826x_get_features,
@@ -4270,7 +4164,7 @@ static struct phy_driver realtek_drvs[]
 		.read_status    = rtl826x_read_status,
 		.config_intr    = rtl826x_config_intr,
 		.handle_interrupt = rtl826x_handle_interrupt,
-		.match_phy_device = rtl8264b_match_phy_device,
+		.match_phy_device = rtl8264b_c45_match_phy_device,
 		.set_wol        = rtl826x_set_wol,
 		.get_wol        = rtl826x_get_wol,
 		.get_tunable    = rtl826x_get_tunable,
